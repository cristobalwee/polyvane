# PolyVane — production env template (the VPS at /opt/polyvane/.env).
# This file should NEVER be committed with real values. Copy to /opt/polyvane/.env
# during provisioning and fill in secrets directly on the box.

# ---- Wallet (live mode only) -------------------------------------------
PK=
WALLET_ADDRESS=

# Polymarket V2 API credentials (live mode only).
# Derive once with: PK=0x... python -m core.derive_creds
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# ---- Kalshi API credentials --------------------------------------------
# Required for Kalshi market-data reads and live trading.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/opt/polyvane/secrets/kalshi_private_key.pem

# ---- Trading mode -------------------------------------------------------
# Kalshi-only deployment: keep TRADING_MODE=paper and flip KALSHI_MODE=live.
# Setting TRADING_MODE=live is only for intentionally re-enabled Polymarket live trading.
TRADING_MODE=paper
KALSHI_MODE=paper

# ---- Monitoring (optional) ---------------------------------------------
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=

# ---- RPC + paths --------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
LOGS_DIR=/opt/polyvane/logs
HEARTBEAT_FILE=/opt/polyvane/data/heartbeat

# ---- API (polyvane-api.service) ----------------------------------------
# Random 32+ char string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The dashboard sends this as the X-API-Key header.
API_SECRET_KEY=

# Comma-separated origins allowed by CORS. Include the dashboard's HTTPS
# URL plus any local-dev origin you use (Vite default is :5173).
DASHBOARD_ORIGINS=https://cristobalgrana.me,http://localhost:5173
