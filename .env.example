# PolyVane — local development env template.
# Copy to .env and fill in values for live trading. Paper mode needs nothing.

# Wallet (only required when TRADING_MODE=live)
PK=
WALLET_ADDRESS=

# Polymarket V2 API credentials (only required when TRADING_MODE=live)
# Derive once with: PK=0x... python -m core.derive_creds
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Kalshi API credentials (required for any market-data reads, even paper mode).
# Key ID comes from your Kalshi account → API Keys. Private key is the RSA .pem
# file you downloaded when creating the key.
# Demo account: https://kalshi.co/sign-up (separate from your live account)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/opt/polyvane/secrets/kalshi_private_key.pem

# Trading mode — keep TRADING_MODE=paper for Kalshi-only operation unless you
# intentionally re-enable Polymarket live trading.
TRADING_MODE=paper

# Kalshi mode is independent. Set KALSHI_MODE=live, add Kalshi credentials,
# and create .live-trading-enabled to allow real Kalshi orders.
KALSHI_MODE=paper

# Monitoring (all optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=

# Polygon RPC for wallet balance reads (live mode only)
POLYGON_RPC_URL=https://polygon-rpc.com

# API (read-only HTTP layer for the remote dashboard).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
# Comma-separated list. Falls back to localhost + cristobalgrana.me if empty.
DASHBOARD_ORIGINS=http://localhost:5173,https://cristobalgrana.me
