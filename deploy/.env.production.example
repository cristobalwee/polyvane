# Wallet (only needed for live trading)
PK=0x...
WALLET_ADDRESS=0x...

# Polymarket API (only needed for live trading)
# Derive with: PK=0x... python -m core.derive_creds
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Kalshi API credentials (required for Kalshi market data and live trading)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/opt/polyvane/secrets/kalshi_private_key.pem

# Trading mode — keep TRADING_MODE=paper for Kalshi-only live trading and
# flip KALSHI_MODE=live when ready.
TRADING_MODE=paper
KALSHI_MODE=paper

# Monitoring
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=

# RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Paths (defaults are correct for the systemd unit)
LOGS_DIR=/opt/polyvane/logs
HEARTBEAT_FILE=/opt/polyvane/data/heartbeat
