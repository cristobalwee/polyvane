# Wallet (only needed for live trading)
PK=0x...
WALLET_ADDRESS=0x...

# Polymarket API (only needed for live trading)
# Derive with: PK=0x... python -m core.derive_creds
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Trading mode — bot starts in paper mode by default
TRADING_MODE=paper

# Monitoring
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=

# RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Paths (defaults are correct for the systemd unit)
LOGS_DIR=/opt/polyvane/logs
HEARTBEAT_FILE=/opt/polyvane/data/heartbeat
